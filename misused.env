# Kernel Source and config naming.
# Motorola Edge S Pro (pstar) / LineageOS 23.2 / Linux 4.19.325
KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_motorola_sm8250
KERNEL_SOURCE_BRANCH=lineage-23.2
KERNEL_CONFIG=vendor/lineageos_pstar_misused_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64
ADD_LOCALVERSION_TO_FILENAME=true
EXTRA_CMDS:LD=ld.lld LOCALVERSION=23-misused

# KernelSU-Next flags
# non-GKI must use the legacy branch of KernelSU-Next (dev/next is GKI-oriented).
# setup.sh must come from the legacy branch; the old "next" path is gone.
ENABLE_KERNELSU=true
KERNELSU_SETUP=https://raw.githubusercontent.com/KernelSU-Next/KernelSU-Next/legacy/kernel/setup.sh
KERNELSU_ROOT=KernelSU-Next
# Pin to legacy branch HEAD at workflow run time.
# If the KSU-side SUSFS patch fails to apply after upstream moves, pin a commit:
#   KERNELSU_TAG=abc123...  (full 40-char sha, no angle brackets)
# Known-good era for 10-ksun-susfs-2.0.0-test.patch is roughly pre-directory-restructure
# legacy snapshots (around v3.0.x / early v3.1 era). Prefer a fixed SHA once you
# find one that builds; "legacy" alone will drift.
KERNELSU_TAG=fd7bb77a416497fa559081487d9bb55fb24f961e
# Upstream legacy does NOT ship built-in SUSFS for non-GKI; we apply external patches.
HAS_KSU_SUSFS_PATCHES=false
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# SUSFS: KSU-side and kernel-side versions MUST match.
# lss4/kernel_patches has for 4.19.325:
#   - 10-ksun-susfs-2.0.0-test.patch          (KSU-Next driver side)
#   - 50_add_susfs_in_kernel-4.19.325-2.0.0   + susfs-2.0.0/{fs,include}
#   - 50_add_susfs_in_kernel-4.19.325-2.1.0   + susfs-2.1.0/{fs,include}
# Pairing 2.0.0 KSU patch with 2.1.0 kernel side causes compile errors.
# Keep both at 2.0.0 unless you also have a matching 2.1.0 KSU-side patch.
SUSFS_PATCH=10-ksun-susfs-2.0.0-test.patch
SUSFS_VERSION=2.0.0

Kernel_Version=4.19
Kernel_Extra_Version=4.19.325
